[Unit]
Description=GoBGP 4.10.0 routing daemon for Hemloc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gobgp
Group=gobgp
ExecStart=/usr/local/bin/gobgpd -f /etc/gobgp/gobgpd.toml --api-hosts=127.0.0.1:50051 --pprof-disable
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Examples use an unprivileged BGP port or disable listening for active-only peers.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
