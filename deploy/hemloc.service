[Unit]
Description=Hemloc prefix blocking controller
After=network-online.target gobgp.service
Wants=network-online.target gobgp.service

[Service]
Type=simple
User=hemloc
Group=hemloc
WorkingDirectory=/opt/hemloc
ExecStart=/opt/hemloc/.venv/bin/hemloc --config /etc/hemloc/hemloc.ini serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
StateDirectory=hemloc
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hemloc
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
